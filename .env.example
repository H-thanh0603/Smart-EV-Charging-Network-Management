# ---- Database (Postgres) ----
# Bắt buộc. Ví dụ Supabase local / docker postgres:
DATABASE_URL="postgresql://user:password@localhost:5432/ev_charging?schema=public"

# ---- Auth JWT ----
# Bắt buộc (>= 16 ký tự). Tạo: openssl rand -hex 32
JWT_SECRET=""

# ---- Web Push (VAPID) ----
# Tạo: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC=""
VAPID_PRIVATE=""
VAPID_SUBJECT="mailto:admin@evcharge.com"

# ---- VNPay (sandbox tốt nhất set VNPAY_URL sandbox) ----
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/return"

# ---- OCPP ----
# Shared secret giữa CSMS (ocpp-server) và charge point / simulator.
OCPP_SECRET=""
# Cổng Central System WebSocket (mặc định 9220)
OCPP_PORT="9220"
# TLS/mTLS — set CERT+KEY để chạy wss://; thêm CLIENT_CA để bắt buộc client cert (mTLS).
# OCPP_TLS_SERVER_CERT="certs/server.crt"
# OCPP_TLS_SERVER_KEY="certs/server.key"
# OCPP_TLS_CLIENT_CA="certs/ca.crt"

# ---- Cron ----
# Khoảng tick cron tự huỷ đặt chỗ (mặc định 60000)
CRON_INTERVAL_MS="60000"
# Secret bảo vệ /api/cron/* — caller phải gửi header x-cron-secret khớp
CRON_SECRET=""

# ---- VP Bank QR (chuyển khoản thủ công, không verify tự động) ----
# RECEIVER tài khoản trong wallet page — tuỳ chỉnh theo tài khoản thật