u, thu trong tuan, khung gio,&lt;br/&gt;ngay bat dau, ngay ket thuc" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="150" as="sourcePoint"/><mxPoint x="300" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="POST /api/reservations/recurring&lt;br/&gt;{slotId, daysOfWeek, startHour, endHour, startDate, endDate}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="202" as="sourcePoint"/><mxPoint x="510" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="INSERT INTO RecurringReservation&lt;br/&gt;(userId, slotId, daysOfWeek, startHour, endHour, startDate, endDate)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="316" as="sourcePoint"/><mxPoint x="720" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="Tao lich lap thanh cong {recurring}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="368" as="sourcePoint"/><mxPoint x="510" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="Phan tach daysOfWeek -&gt; mang cac thu (0-6)&lt;br/&gt;Xac dinh khoang ngay" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="482" as="sourcePoint"/><mxPoint x="510" y="520" as="targetPoint"/><Array as="points"><mxPoint x="574" y="482"/><mxPoint x="574" y="520"/></Array></mxGeometry></mxCell><mxCell id="m6" value="Kiem tra ngay hien tai co thuoc daysOfWeek?" style="html=1;verticalAlign=bottom;endArrow=blo