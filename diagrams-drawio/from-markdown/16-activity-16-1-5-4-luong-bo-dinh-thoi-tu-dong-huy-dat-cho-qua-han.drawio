ọi API&lt;br/&gt;/api/cron/expire-reservations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="348" y="360" width="182" height="58" as="geometry"/></mxCell><mxCell id="step_3" value="Tính thời điểm cắt&lt;br/&gt;(cutoff = hiện tại - 15 phút)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="176" width="182" height="58" as="geometry"/></mxCell><mxCell id="step_4" value="Truy vấn tất cả đặt chỗ&lt;br/&gt;có trạng thái PENDING&lt;br/&gt;và startTime ≤ cutoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="268" width="182" height="58" as="geometry"/></mxCell><mxCell id="step_5" value="Có đặt chỗ quá hạn?? (Có)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="104" y="360" width="130" height="76" as="geometry"/></mxCell><mxCell id="step_6" value="repeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="92" y="476" width="154" height="42" as="geometry"/></mxCell><mxCell id="step_7" value="Bắt đầu giao dịch (transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="568" width="182" height="58" as="geometry"/></mxCell><mxCell id="step_8" value="Cập nhật đặt chỗ&lt;br/&gt;→ CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="660" width="182" height="58" as="geometry"/></mxCell><mxCell id="step_9" value="Tạo thông báo WARNING&lt;br/&gt;gửi cho người dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78