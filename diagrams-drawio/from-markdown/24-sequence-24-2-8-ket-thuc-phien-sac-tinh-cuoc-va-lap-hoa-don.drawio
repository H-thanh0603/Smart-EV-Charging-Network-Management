TRANSACTION (atomic) ===" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="786" width="370" height="48" as="geometry"/></mxCell><mxCell id="m1" value="Nhan &quot;Ket thuc sac" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="150" as="sourcePoint"/><mxPoint x="300" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="POST /api/sessions/{id}/stop" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="202" as="sourcePoint"/><mxPoint x="510" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="SELECT session + slot + user + fleet&lt;br/&gt;WHERE session.id = ?" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="254" as="sourcePoint"/><mxPoint x="720" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="Tra ve session (ACTIVE) + slot.powerKw + user.fleet" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="306" as="sourcePoint"/><mxPoint x="510" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="endTime = now()&lt;br/&gt;durationHours = (endTime - startTime) / 3600000&lt;br/&gt;energyKwh = durationHours x powerKw x 0.9" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="420" as="sourcePoint"/><mxPoint x="510" y="458" as="targetPoint"/><Array as="points"><mxPoint x="574" y="420"/><mxPoint x="574" y="458"/></Array></mxGeometry></mxCell><mxCell id="m6" value="SELECT * FROM Tariff&lt;br/&gt;WHERE active = 1 AND startHour &lt;= h &lt; endHour&lt;br/&gt;ORDER BY isPeak DESC" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="478" as="sourcePoint"/><mxPoint x="720" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="Tra ve bieu gia {ratePerKwh, isPeak}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="530" as="sourcePoint"/><mxPoint x="510" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="subtotal = energyKwh x ratePerKwh" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="582" as="sourcePoint"/><mxPoint x="510" y="620" as="targetPoint"/><Array as="points"><mxPoint x="574" y="582"/><mxPoint x="574" y="620"/></Array></mxGeometry></mxCell><mxCell id="m9" value="fleetDiscount = subtotal x fleet.discountRate / 100&lt;br/&gt;amount = subtotal - fleetDiscount" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="668" as="sourcePoint"/><mxPoint x="510" y="706" as="targetPoint"/><Array as="points"><mxPoint x="574" y="668"/><mxPoint x="574" y="706"/></Array></mxGeometry></mxCell><mxCell id="m10" value="pointsEarned = floor(amount / 10000)&lt;br/&gt;newTier = tinh hang thanh vien tu tong diem" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="748" as="sourcePoint"/><mxPoint x="510" y="786" as="targetPoint"/><Array as="points"><mxPoint x="574" y="748"/><mxPoint x="574" y="786"/></Array></mxGeometry></mxCell><mxCell id="m11" value="BEGIN TRANSACTION" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="868" as="sourcePoint"/><mxPoint x="720" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="UPDATE ChargingSession SET status='COMPLETED', endTime, energyKwh" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="920" as="sourcePoint"/><mxPoint x="720" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="UPDATE Slot SET status='AVAILABLE'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="972" as="sourcePoint"/><mxPoint x="720" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="INSERT INTO Invoice (sessionId, userId, energyKwh, subtotal, discount, amount, pointsEarned)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1024" as="sourcePoint"/><mxPoint x="720" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="UPDATE User SET loyaltyPoints += pointsEarned, loyaltyTier = newTier" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1076" as="sourcePoint"/><mxPoint x="720" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="INSERT INTO LoyaltyTransaction (type='EARN', points, balance)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#222222;fontSize=12;" edge="1" parent="1"><mx