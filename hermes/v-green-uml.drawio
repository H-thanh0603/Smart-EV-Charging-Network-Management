ometry" /></mxCell><mxCell id="clsSession" value="&lt;b&gt;ChargingSession&lt;/b&gt; (Phiên sạc)&lt;hr&gt;&lt;font color='#333333'&gt;- id: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- userId: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- slotId: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- reservationId: String {unique}&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- startTime: DateTime&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- endTime: DateTime&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- energyKwh: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- status: String [ACTIVE | COMPLETED]&lt;/font&gt;&lt;hr&gt;&lt;i&gt;+ start(): void&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ stop(): void&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ getEnergyUsed(): Double&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="200" height="210" as="geometry" /></mxCell><mxCell id="clsInvoice" value="&lt;b&gt;Invoice&lt;/b&gt; (Hóa đơn)&lt;hr&gt;&lt;font color='#333333'&gt;- id: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- invoiceNo: String {unique}&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- sessionId: String {unique}&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- userId: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- energyKwh: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- amount: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- discount: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- status: String [UNPAID | PAID]&lt;/font&gt;&lt;hr&gt;&lt;i&gt;+ processPayment(): Boolean&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ generatePdf(): File&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="530" y="280" width