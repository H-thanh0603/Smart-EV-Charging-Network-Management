      <mxCell id="clsUser" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;font color='#333333'&gt;- id: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- email: String {unique}&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- password: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- name: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- phone: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- role: String [CUSTOMER | DRIVER | TECHNICIAN | ADMIN]&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- loyaltyPoints: Int&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- loyaltyTier: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- fleetId: String (optional)&lt;/font&gt;&lt;hr&gt;&lt;i&gt;+ register(): Boolean&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ login(): Token&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ updateProfile(): void&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="200" height="210" as="geometry" /></mxCell><mxCell id="clsStation" value="&lt;b&gt;Station&lt;/b&gt;&lt;hr&gt;&lt;font color='#333333'&gt;- id: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- name: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- address: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- city: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- lat: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- lng: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- status: String&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- rating: Double&lt;/font&gt;&lt;br&gt;&lt;font color='#333333'&gt;- isPremium: Boolean&lt;/font&gt;&lt;hr&gt;&lt;i&gt;+ getSlots(): Slot[]&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ getAvgRating(): Double&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;overflow=hidden;" v